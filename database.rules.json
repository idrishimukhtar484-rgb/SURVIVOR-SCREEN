{
  "rules": {
    "usernames": {
      ".read": true,
      "$u": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.child('deposited').val() === 0 && newData.child('winning').val() === 0 && newData.child('totalWinnings').val() === 0 && newData.child('wins').val() === 0 && newData.child('totalMatches').val() === 0 && newData.child('totalWithdrawn').val() === 0 && newData.child('blocked').val() === false && !newData.hasChild('referralRewarded')"
      },
      ".indexOn": [
        "email",
        "mobile",
        "username"
      ]
    },
    "games": {
      ".read": true
    },
    "banners": {
      ".read": true
    },
    "matches": {
      ".read": true,
      ".indexOn": [
        "gameId",
        "status"
      ]
    },
    "matchRooms": {
      "$mid": {
        ".read": "auth != null && root.child('userMatches').child(auth.uid).child($mid).exists()"
      }
    },
    "userMatches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "transactions": {
      "$uid": {
        ".indexOn": [
          "at"
        ],
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "deposits": {
      ".indexOn": [
        "status",
        "createdAt"
      ]
    },
    "lb": {
      ".read": true,
      "$t": {
        "$k": {
          "$g": {
            ".indexOn": [
              "amount"
            ]
          }
        }
      }
    },
    "ads": {
      ".read": true
    },
    "announcements": {
      ".read": true
    },
    "feedback": {
      ".read": true
    },
    "appConfig": {
      ".read": true,
      ".write": "auth != null && (root.child(\"adminPerms\").child(auth.uid).child(\"owner\").val() === true || root.child(\"adminPerms\").child(auth.uid).child(\"settings_manage\").val() === true)"
    },
    "recentWithdrawals": {
      ".read": true
    },
    "referrals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "tutorials": {
      ".read": true
    },
    "withdrawals": {
      ".indexOn": [
        "status",
        "at"
      ]
    },
    "userNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "at"
        ]
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publishedUpdates": {
      ".read": "auth != null",
      ".indexOn": [
        "publishedAt"
      ],
      ".write": "auth != null && (root.child(\"adminPerms\").child(auth.uid).child(\"owner\").val() === true || root.child(\"adminPerms\").child(auth.uid).child(\"settings_manage\").val() === true)"
    },
    "userUpdateReads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "adminUpdates": {
      ".read": "auth != null && (root.child(\"adminPerms\").child(auth.uid).child(\"owner\").val() === true || root.child(\"adminPerms\").child(auth.uid).child(\"settings_manage\").val() === true)",
      ".write": "auth != null && (root.child(\"adminPerms\").child(auth.uid).child(\"owner\").val() === true || root.child(\"adminPerms\").child(auth.uid).child(\"settings_manage\").val() === true)"
    },
    "adminPerms": {
      ".read": "auth != null",
      ".write": "auth != null && root.child(\"admins\").child(auth.uid).child(\"role\").val() === \"owner\""
    }
  }
}
